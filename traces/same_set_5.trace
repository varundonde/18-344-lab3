# Five pages share one four-way TLB set. Reuse the first page before adding a fifth.
map 0x10000 4096
map 0x20000 4096
map 0x30000 4096
map 0x40000 4096
map 0x50000 4096
repeat 32
  load 0x10000
  load 0x20000
  load 0x30000
  load 0x40000
  load 0x10000
  load 0x50000
  load 0x10000
  load 0x20000
end
