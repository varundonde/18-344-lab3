# Two TLB sets each hold five competing pages, for ten mapped pages total.
map 0x10000 8192
map 0x20000 8192
map 0x30000 8192
map 0x40000 8192
map 0x50000 8192
repeat 24
  load 0x10000
  load 0x11000
  load 0x20000
  load 0x21000
  load 0x30000
  load 0x31000
  load 0x40000
  load 0x41000
  load 0x10000
  load 0x11000
  load 0x50000
  load 0x51000
  load 0x10000
  load 0x11000
  load 0x20000
  load 0x21000
end
